# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging（目录规则限定在仓库根，避免误伤 web/src/lib/ 这类源码目录）
.Python
env/
venv/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# IPython Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# dotenv
.env
.env.local
.env.*.local
*.env

# virtualenv
.venv/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# profiling data
.prof

# PyCharm
.idea/

# VS Code
.vscode/

# Frontend packages are installed from the committed pnpm lockfile.
/web/node_modules/

resource/

# Vite build output (generated by ``cd web && pnpm build``).
/static/

# Local pnpm content-addressable store.
.pnpm-store/

# 本地配置：不入库，模板见 config.template.yaml
config.yaml
# config.yaml 的本地备份（`config.yaml.bak-<日期>-<时刻>`）：里面是明文凭据，绝不入库。
config.yaml.bak*

# macOS
.DS_Store

# superpowers 的临时工作区（执行台账、任务简报、审核材料）；需要留存的台账复制到 docs/superpowers/ledgers/
.superpowers/

# archify 的架构图工作区（HTML/PNG/JSON 生成物，单份约 2.8 MB）；要交付的图另存到 docs/ 或附件。
.archify/

# 文案审计的机器可读全量记录（2.8 MB，随时可由 scripts/copy_inventory.py 重建）。
# 规则命中基线 lint-baseline.json 要入库：它是 --check 防回潮闸门的比较对象。
docs/copy-audit/inventory.json
# 抽取器运行期的中间文件（正常结束会自行删除）。
.copy-inventory-web.json

# Agent 调试产物（截图/地图等），不进版本库
debug/
